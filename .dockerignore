.env
.env.*
!.env.example

# Docker
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# CI / platform
.netlify
.vercel

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Tests & coverage
coverage
__tests__
**/*.spec.ts
**/*.test.ts

# Bolt internal
.bolt
.v3

# Supabase — functions are deployed separately via the Supabase CLI / MCP
supabase/.temp
supabase/.branches
