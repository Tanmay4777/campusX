# ==============================================================================
# CampusX — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# NEVER commit your real `.env` file. It is gitignored.
# ==============================================================================

# --- Supabase (public, safe for the browser) ---------------------------------
# Project URL: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key: Supabase dashboard → Project Settings → API → Project API
# Keys → anon public. This is safe to expose to the browser; RLS policies
# enforce access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (SERVER-ONLY — never expose to the browser) --------------------
# Service role key: Supabase dashboard → Project Settings → API → Project API
# Keys → service_role. This bypasses RLS and must ONLY be used on the server
# (Edge Functions, server components, server actions). NEVER prefix with
# NEXT_PUBLIC_ and NEVER import it from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Edge Functions (Deno runtime secrets) -----------------------------------
# These are set in the Supabase dashboard under Edge Functions → Secrets, NOT
# in the Next.js .env. They are documented here for completeness.

# Optional GitHub token used by the analyze-repo edge function to raise the
# unauthenticated rate limit when fetching repository data.
GITHUB_TOKEN=
